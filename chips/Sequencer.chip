// Crumb's heartbeat. Every instruction is two ticks: a fetch tick, then an
// execute tick, and `execute` says which one this is. The program counter
// `pc` moves at the end of each execute tick:
//
//   ret             -> the low 13 bits of R (returning from a call)
//   jump            -> addr (Decode says jump for calls too)
//   jz, if T is 0   -> addr
//   otherwise       -> pc1, which is pc + 1
//
// `reset` starts it at address 0, ready to fetch.
chip Sequencer {
  in  reset, jump, jz, ret, t[16], r[16], addr[13]
  out execute, pc[13], pc1[13]
  not1 = Not(dff1)
  mux1 = Mux(not1, 0, reset)
  dff1 = Dff(mux1)
  register16_1 = Register16({0b000, mux3}, dff1, reset)
  inc13_1 = Inc13(register16_1[12:0])
  compare16_1 = Compare16(t, 0)
  and1 = And(jz, compare16_1.eq)
  or1 = Or(jump, and1)
  mux2 = Mux(inc13_1, addr, or1)
  mux3 = Mux(mux2, r[12:0], ret)
  execute = dff1
  pc = register16_1[12:0]
  pc1 = inc13_1
}

test Sequencer {
  set reset = 1, jump = 0, jz = 0, ret = 0, t = 0, r = 0, addr = 0
  tick
  expect execute = 0, pc = 0, pc1 = 1       // reset: fetching from address 0
  set reset = 0
  tick
  expect execute = 1, pc = 0                // a fetch tick leaves the PC alone
  tick
  expect execute = 0, pc = 1, pc1 = 2       // after execute, on to the next one
  tick 2
  expect pc = 2
  // jump: the PC goes to addr, at the end of the execute tick
  set jump = 1, addr = 0x0100
  tick
  expect execute = 1, pc = 2
  tick
  expect execute = 0, pc = 0x0100
  // jz while T isn't 0: no jump
  set jump = 0, jz = 1, t = 5, addr = 0x0042
  tick 2
  expect pc = 0x0101
  // jz while T is 0: jump
  set t = 0
  tick 2
  expect pc = 0x0042
  // ret: back to the address in R (only its low 13 bits count)
  set jz = 0, ret = 1, r = 0xE123
  tick 2
  expect pc = 0x0123
  // the end of ROM wraps around
  set r = 0x1FFF
  tick 2
  expect pc = 0x1FFF, pc1 = 0
  set ret = 0
  tick 2
  expect pc = 0
  // reset in the middle of an instruction goes back to fetching at 0
  tick 3
  expect execute = 1, pc = 1
  set reset = 1
  tick
  expect execute = 0, pc = 0
}
