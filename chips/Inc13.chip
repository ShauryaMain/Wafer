// Adds 1 to a 13-bit number: the program counter's next address. It wraps
// around from 0x1FFF (the last word of the 8K ROM) back to 0.
chip Inc13 {
  in  a[13]
  out out[13]
  add16_1 = Add16({0b000, a}, 1, 0)
  out = add16_1.sum[12:0]
}

test Inc13 {
  // a      | out
     0x0000 | 0x0001
     0x0001 | 0x0002
     0x00FF | 0x0100  // the carry ripples up through eight bits
     0x0FFF | 0x1000
     0x1234 | 0x1235
     0x1FFE | 0x1FFF
     0x1FFF | 0x0000  // the end of ROM wraps around to the start
}
