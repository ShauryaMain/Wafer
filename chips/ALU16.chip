// Crumb's ALU. It works out all 16 operations at once, and `op` picks the
// one that comes out (the table is in docs/crumb.md). `t` is the top of the
// data stack (T), `n` the word under it (N), `r` the top of the return stack
// (R), and `mem` the memory word at address T.
//
//   0 T        4 T and N    8  N = T        12 N >> T
//   1 N        5 T or N     9  N < T        13 mem
//   2 T + N    6 T xor N    10 N < T (u)    14 R
//   3 N - T    7 not T      11 N << T       15 T - 1
//
// Comparisons give Forth flags: 0xFFFF for true, 0 for false.
chip ALU16 {
  in  t[16], n[16], r[16], mem[16], op[4]
  out out[16]
  not1 = Not(t)
  add = Add16(t, n, 0)
  sub = Add16(n, not1, 1)
  dec = Add16(t, 0xFFFF, 0)
  and1 = And(t, n)
  xor1 = Xor(t, n)
  or1 = Or(t, n)
  cmp = Compare16(n, t)
  mux1 = Mux(0, 0xFFFF, cmp.eq)
  mux2 = Mux(0, 0xFFFF, cmp.lt)
  mux3 = Mux(0, 0xFFFF, cmp.ult)
  shift = Shift16(n, t[3:0])
  mux4_1 = Mux4(t, n, add.sum, sub.sum, op[0], op[1])
  mux4_2 = Mux4(and1, or1, xor1, not1, op[0], op[1])
  mux4_3 = Mux4(mux1, mux2, mux3, shift.left, op[0], op[1])
  mux4_4 = Mux4(shift.right, mem, r, dec.sum, op[0], op[1])
  mux4_5 = Mux4(mux4_1, mux4_2, mux4_3, mux4_4, op[2], op[3])
  out = mux4_5
}

test ALU16 {
  // t      n      r      mem    op | out
     0x0003 0x00F5 0xBEEF 0x1234 0  | 0x0003  // T
     0x0003 0x00F5 0xBEEF 0x1234 1  | 0x00F5  // N
     0x0003 0x00F5 0xBEEF 0x1234 2  | 0x00F8  // T + N
     0x0003 0x00F5 0xBEEF 0x1234 3  | 0x00F2  // N - T
     0x0003 0x00F5 0xBEEF 0x1234 4  | 0x0001  // T and N
     0x0003 0x00F5 0xBEEF 0x1234 5  | 0x00F7  // T or N
     0x0003 0x00F5 0xBEEF 0x1234 6  | 0x00F6  // T xor N
     0x0003 0x00F5 0xBEEF 0x1234 7  | 0xFFFC  // not T
     0x0003 0x00F5 0xBEEF 0x1234 8  | 0x0000  // N = T
     0x0003 0x00F5 0xBEEF 0x1234 9  | 0x0000  // N < T, signed
     0x0003 0x00F5 0xBEEF 0x1234 10 | 0x0000  // N < T, unsigned
     0x0003 0x00F5 0xBEEF 0x1234 11 | 0x07A8  // N << T
     0x0003 0x00F5 0xBEEF 0x1234 12 | 0x001E  // N >> T
     0x0003 0x00F5 0xBEEF 0x1234 13 | 0x1234  // mem
     0x0003 0x00F5 0xBEEF 0x1234 14 | 0xBEEF  // R
     0x0003 0x00F5 0xBEEF 0x1234 15 | 0x0002  // T - 1
     0x0005 0x0003 0xBEEF 0x1234 3  | 0xFFFE  // N - T going below zero
     0x0000 0x0000 0xBEEF 0x1234 15 | 0xFFFF  // 0 - 1 wraps around
     0x0007 0x0007 0xBEEF 0x1234 8  | 0xFFFF  // equal: true is all 1s
     0x0001 0xFFFF 0xBEEF 0x1234 9  | 0xFFFF  // -1 < 1, signed
     0x0001 0xFFFF 0xBEEF 0x1234 10 | 0x0000  // but 65535 isn't < 1
     0x0014 0x00F5 0xBEEF 0x1234 11 | 0x0F50  // only T's low 4 bits count: 0x14 shifts by 4
     0x000F 0x8001 0xBEEF 0x1234 12 | 0x0001
     0xFFFF 0x0001 0xBEEF 0x1234 2  | 0x0000  // the carry falls off the top
}
