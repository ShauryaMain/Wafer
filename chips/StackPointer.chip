// Points into one of Crumb's 32-word stacks. On each clock tick with `move`
// at 1, it moves by `delta`: 00 stays, 01 is +1, 10 is -2 and 11 is -1. It
// wraps around (31 + 1 is 0, and 0 - 2 is 30). `reset` puts it back to 0 on
// a tick, and wins over `move`. Crumb has two: one for the data stack and
// one for the return stack.
chip StackPointer {
  in  delta[2], move, reset
  out sp[5]
  mux4_1 = Mux4(0x00, 1, 0xFE, 0xFF, delta[0], delta[1])
  add8_1 = Add8(dff1, mux4_1, 0)
  mux1 = Mux(dff1, add8_1.sum, move)
  mux2 = Mux(mux1, 0, reset)
  dff1 = Dff(mux2)
  sp = dff1[4:0]
}

test StackPointer {
  set delta = 0b00, move = 0, reset = 1
  tick
  expect sp = 0
  set reset = 0, move = 1, delta = 0b01    // +1
  tick
  expect sp = 1
  tick
  expect sp = 2
  tick 3
  expect sp = 5
  set delta = 0b11                          // -1
  tick
  expect sp = 4
  set delta = 0b10                          // -2
  tick
  expect sp = 2
  set delta = 0b00                          // stay
  tick
  expect sp = 2
  set delta = 0b10
  tick
  expect sp = 0
  tick
  expect sp = 30                            // below 0 wraps around to the top
  set delta = 0b01
  tick
  expect sp = 31
  tick
  expect sp = 0                             // and past 31 back to 0
  set move = 0
  tick 3
  expect sp = 0                             // move is 0: it stays put
  set move = 1
  tick
  expect sp = 1
  set reset = 1
  tick
  expect sp = 0                             // reset wins over move
}
