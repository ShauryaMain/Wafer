// Shifts a 16-bit number by 0 to 15 places, both ways at once: `left`
// moves every bit up `by` places, and `right` moves them down. Bits that
// fall off the end are lost, and 0s come in at the other end. This is a
// barrel shifter: four stages that each shift by 1, 2, 4 or 8, or pass the
// number through, picked by one bit of `by`. ALU16 uses `left` for
// `lshift` and `right` for `rshift`.
chip Shift16 {
  in  a[16], by[4]
  out left[16], right[16]
  mux1 = Mux(a, {a[14:0], 0b0}, by[0])
  mux2 = Mux(mux1, {mux1[13:0], 0b00}, by[1])
  mux3 = Mux(mux2, {mux2[11:0], 0x0}, by[2])
  mux4 = Mux(mux3, {mux3[7:0], 0x00}, by[3])
  mux5 = Mux(a, {0b0, a[15:1]}, by[0])
  mux6 = Mux(mux5, {0b00, mux5[15:2]}, by[1])
  mux7 = Mux(mux6, {0x0, mux6[15:4]}, by[2])
  mux8 = Mux(mux7, {0x00, mux7[15:8]}, by[3])
  left = mux4
  right = mux8
}

test Shift16 {
  // a      by | left   right
     0x0001 0  | 0x0001 0x0001
     0x0001 1  | 0x0002 0x0000
     0x8000 1  | 0x0000 0x4000
     0x8000 15 | 0x0000 0x0001
     0x1234 4  | 0x2340 0x0123
     0x1234 8  | 0x3400 0x0012
     0xFFFF 15 | 0x8000 0x0001
     0xABCD 3  | 0x5E68 0x1579
     0xF00F 5  | 0x01E0 0x0780
     0x00FF 12 | 0xF000 0x0000
     0x5555 2  | 0x5554 0x1555
     0xFFFF 0  | 0xFFFF 0xFFFF
}
